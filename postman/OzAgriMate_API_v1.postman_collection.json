  },
  "variable": [
    {
      "key": "farmDeviceUrl",
      "value": "http://localhost:8001"
    },
    {
      "key": "telemetryUrl",
      "value": "http://localhost:8002"
    },
    {
      "key": "monitoringUrl",
      "value": "http://localhost:8003"
    },
    {
      "key": "irrigationUrl",
      "value": "http://localhost:8004"
    }
  ],
  "item": [
    {
      "name": "1. Farm and Device Management Service (port 8001)",
      "item": [
        {
          "name": "E1 POST /farms - register farm (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Location header\", () => pm.response.to.have.header(\"Location\"));",
                  "pm.test(\"New farm id\", () => pm.expect(body.farmId).to.match(/^FARM-\\d+$/));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "USR-101"
              },
              {
                "key": "X-User-Role",
                "value": "FARM_MANAGER"
              },
              {
                "key": "X-Farm-Access",
                "value": "FARM-001"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{farmDeviceUrl}}/api/v1/farms",
              "host": [
                "{{farmDeviceUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "farms"
              ]
            },
            "description": "Endpoint 1. Registers a farm; returns 201 Created and a Location header.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wattle Creek Vineyard\",\n  \"propertyIdentificationCode\": \"SA123456\",\n  \"farmType\": \"VITICULTURE\",\n  \"location\": {\n    \"state\": \"SA\",\n    \"region\": \"Barossa Valley\",\n    \"latitude\": -34.5333,\n    \"longitude\": 138.95\n  },\n  \"areaHectares\": 64.0,\n  \"timezone\": \"Australia/Adelaide\",\n  \"irrigationZones\": [\n    {\n      \"zoneId\": \"ZONE-A\",\n      \"name\": \"Shiraz Block\",\n      \"areaHectares\": 30.0,\n      \"cropType\": \"Shiraz grapes\"\n    }\n  ]\n}",
              "options": {
                "raw": {
