    {
      "name": "2. Telemetry Ingestion Service (port 8002)",
      "item": [
        {
          "name": "E4 POST /telemetry - vendor units normalised (202)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 202\", () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test(\"Accepted and published\", () => { pm.expect(body.status).to.eql(\"ACCEPTED\"); pm.expect(body.publishedTo).to.eql(\"telemetry.received\"); });",
                  "pm.test(\"FRACTION converted to PERCENT\", () => pm.expect(body.readings[0].value).to.eql(14.2));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "GW-FARM-001"
              },
              {
                "key": "X-User-Role",
                "value": "DEVICE_GATEWAY"
              },
              {
                "key": "X-Farm-Access",
                "value": "FARM-001"
              },
