        {
          "name": "E5 GET /farms/{farmId}/telemetry/latest - latest readings (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Stale reading flagged\", () => pm.expect(body.readings.some(r => r.stale === true)).to.be.true);",
                  "pm.test(\"New reading present\", () => pm.expect(body.readings.some(r => r.deviceId === \"DEV-1001\" && r.value === 14.2)).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "USR-301"
              },
              {
                "key": "X-User-Role",
                "value": "AGRONOMIST"
              },
              {
